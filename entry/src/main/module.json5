{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "2in1",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 原生库压缩打包 + 安装时解到 libs/：libnode.so ≈121 MB，STORED 会让 HAP 膨胀。
    // 这两个键必须写在 module 级（写进 build-profile.json5 会被 schema 拒绝）。
    "compressNativeLibs": true,
    "extractNativeLibs": true,
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // 长时任务：agent 长回合不被系统挂起（与 dsh-desktop-hos 的 Electron 壳同口径）。
        "backgroundModes": [
          "taskKeeping"
        ],
        // 端口随机 + 数据目录唯一的前提：多实例会互抢 <filesDir> 与 cookie audience。
        "launchType": "singleton",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    // 声明面口径见 docs/ACL配置.md §1（逐项判定依据）与 docs/ACL-无ACL评估.md。
    // 规则：受限开放权限（需 ACL）⟺ provisionEnable == true 且 availableLevel ∈ {system_basic, system_core}。
    "requestPermissions": [
      // ── 开放权限（normal + system_grant，安装即授予；不需 ACL）──────────────────
      // 2026-10-21：声明面与参考工程 `pi-desktop-ark` 全量对齐（用户决定）。逐项判定见 docs/ACL配置.md §1。
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.ACCESS_CERT_MANAGER" },
      { "name": "ohos.permission.RUNNING_LOCK" },
      { "name": "ohos.permission.PRINT" },
      {
        "name": "ohos.permission.PREPARE_APP_TERMINATE",
        "reason": "$string:prepare_app_terminate",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      { "name": "ohos.permission.ACCESS_BIOMETRIC" },
      { "name": "ohos.permission.PRIVACY_WINDOW" },
      { "name": "ohos.permission.WINDOW_TOPMOST" },
      { "name": "ohos.permission.KEEP_BACKGROUND_RUNNING" },
      // 随包 Node 运行时继承父进程权限；名字带 kernel. 但 provisionEnable=false ⇒ 开放权限。
      {
        "name": "ohos.permission.INHERIT_PARENT_PERMISSION",
        "reason": "$string:inherit_parent_permission",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      // 加载随包原生库（libnode.so / libnode_bridge.so）时跳过库校验；同上，开放权限。
      {
        "name": "ohos.permission.kernel.IGNORE_LIBRARY_VALIDATION",
        "reason": "$string:ignore_library_validation",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      // 随包运行时申请匿名可执行内存（开放权限；**不能**替代 JIT ACL，见 ACL 文档 §2）。
      {
        "name": "ohos.permission.kernel.EXEMPT_ANONYMOUS_EXECUTABLE_MEMORY",
        "reason": "$string:exempt_anonymous_executable_memory",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      { "name": "ohos.permission.GYROSCOPE" },
      { "name": "ohos.permission.ACCELEROMETER" },
      { "name": "ohos.permission.GET_FILE_ICON" },
      { "name": "ohos.permission.LOCK_WINDOW_CURSOR" },
      // ── 用户授权（normal + user_grant）：装完未授权，由用户在对话框点「请求权限」──────────
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_dir",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_dir",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",
        "reason": "$string:screen_capture",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      }
      // ── 受限开放权限（需 ACL，Profile 必须授权，否则装机即拒）────────────────────
      // 109-jitless：JIT 权限只属于 `jit` 形态；标记之间的内容由 `scripts/set-node-mode.mjs`
      // 维护 —— 默认 compat（不声明 ⇒ 零 ACL 可安装）；切 jit 时脚本会成对加回 request/define。
      // JIT：内置 Node/V8 必需；无它且不带 --jitless 会 SIGTRAP（真机实测）。
      // [109-jitless:jit:request:begin]
      // [109-jitless:jit:request:end]
    ],
    // 与 requestPermissions 成对出现（受限权限两处都要有）。
    "definePermissions": [
      { "name": "ohos.permission.LOCK_WINDOW_CURSOR" }
      // [109-jitless:jit:define:begin]
      // [109-jitless:jit:define:end]
    ]
  }
}
